{
  "name": "@woody_s/htmledit",
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-runtime.mjs",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "examples": "tsx scripts/generate-examples.ts",
    "smoke:production": "tsx scripts/smoke-production.ts",
    "format": "prettier --write src tests scripts skills bin *.ts *.json README.md docs .github",
    "format:check": "prettier --check src tests scripts skills bin *.ts *.json README.md docs .github",
    "prepack": "npm run build",
    "test:package": "node scripts/smoke-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "lucide-react": "^0.577.0",
    "parse5": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Local visual HTML editor and review skills for Claude Code and Codex",
  "license": "MIT",
  "author": "ChiwooSong",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChiwooSong/htmledit.git"
  },
  "homepage": "https://github.com/ChiwooSong/htmledit#readme",
  "bin": {
    "htmledit": "bin/htmledit.mjs"
  },
  "files": [
    "bin/",
    "runtime/",
    "dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "html",
    "editor",
    "claude-code",
    "codex",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  }
}
